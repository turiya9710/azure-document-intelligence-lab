<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AzureDocumentIntelligenceLab</RootNamespace>
    <AssemblyName>docintel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- GA SDK for REST API 2024-11-30 (v4.0). Older Azure.AI.FormRecognizer packages are the v3 generation. -->
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
  </ItemGroup>

</Project>
